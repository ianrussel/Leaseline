# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.

# Required for the chat widget (api/chat.js) to answer questions.
# Get one at https://console.anthropic.com/ -> API Keys -> Create Key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. When set, every chat question+answer is forwarded here (a Formspree form
# endpoint, which emails it to you) - the widget has no other storage. Leave unset to
# disable logging entirely; chat still works fine either way.
# CHAT_LOG_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Required for the triage endpoint (api/triage.js) to answer maintenance-triage requests.
# The URL of the Hugging Face Inference Endpoint serving the fine-tuned model - see
# leaseline-training's private/task-leaseline-triage/deploy-inference-endpoint.md.
HF_ENDPOINT_URL=https://xxxxxxxxxxxxxxxx.endpoints.huggingface.cloud

# Must be a READ-ONLY fine-grained token scoped to the model repo - never the write-scoped
# token used locally to create/upload it (see deploy-inference-endpoint.md step 0 for why
# these are deliberately two different tokens).
HF_TOKEN=hf_...

# Required for api/triage.js to verify who's calling it - a Supabase project's URL and its
# SERVICE ROLE (secret, admin-level) key, used server-side only to validate the session token
# dashboard.html sends. Get both from the Supabase dashboard: Project Settings -> API.
# NEVER expose the service_role key client-side - that's what the separate anon/public key
# (hardcoded directly in dashboard.html, safe to expose by design) is for.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Required for api/analyze-tickets.js (the daily cron job that flags real-tenant-data training
# candidates). Set CRON_SECRET to any random string, then set the SAME value in Vercel's
# dashboard - Vercel automatically sends it as `Authorization: Bearer <CRON_SECRET>` on its own
# cron requests, which is how the endpoint tells a real cron trigger apart from a random public
# GET to that URL. Generate one with: openssl rand -hex 32
CRON_SECRET=...

# Where the "new training candidate(s)" notification email goes. Any address you actually read.
ADMIN_EMAIL=you@example.com

# Get one free at https://resend.com (no credit card required for the free tier - 3,000
# emails/month). Used by two places: analyze-tickets.js (admin notification email) and
# send-reply.js (the dashboard's real "Send via email" action). Create this one with
# "Sending access" permission only - it never needs to read anything.
RESEND_API_KEY=re_...

# Required for api/inbound-email.js (receiving tenant emails automatically - see README.md's
# "Inbound email" section for the full setup walkthrough). Deliberately a SEPARATE Resend API
# key from RESEND_API_KEY above, and it MUST be created with "Full access" permission - Resend's
# GET /emails/receiving/{id} endpoint (used to fetch a received email's body) 401s with
# "This API key is restricted to only send emails" if given a Sending-access key. Using one
# Full-access key everywhere would hand the sending-only code paths more privilege than they
# need, so this is intentionally its own key: Resend dashboard -> API Keys -> Create API Key ->
# Full access.
RESEND_RECEIVING_API_KEY=re_...

# Required for api/inbound-email.js. This is the signing secret from Resend's dashboard:
# Webhooks -> your webhook -> copy the secret. Used to verify a webhook request genuinely came
# from Resend, not an unauthenticated POST from anyone who finds the URL.
RESEND_WEBHOOK_SECRET=whsec_...

# No env var for which account owns received email - that's per-customer now, managed in
# admin.html's "Customers" panel (see the `customers` table in supabase/schema.sql), not a single
# hardcoded account. Add each customer there: a name, a unique local-part (the part of the email
# address before @), and which existing Supabase user manages their tickets.

# The domain admin.html displays customer inbound addresses as (local_part@this) - your Resend
# dashboard's Emails -> Receiving -> "Receiving address" free subdomain by default, or a verified
# custom domain later once you have one. Purely a display value: api/inbound-email.js's routing
# matches on local-part alone regardless of domain, so changing this later never breaks existing
# customers - it just changes what admin.html shows for their address.
RESEND_RECEIVING_DOMAIN=your-id.resend.app

# Usage/plan tracking (api/_lib/billing.js) - display and reminder-email purposes only by
# default; nothing charges anyone, since no payment processor is integrated yet (see progress.md's
# Phase 3 notes). All optional; defaults shown below.
#
# ENFORCE_USAGE_LIMITS - "true" to actually block triage (api/triage.js) once a customer hits
#   MONTHLY_TRIAGE_LIMIT for the period, returning a 403 with code "usage_limit_reached" instead of
#   just displaying usage. Off by default so enabling it is a deliberate choice, not a silent
#   behavior change for customers already using the product. Turn this on before onboarding anyone
#   you're not personally tracking usage for by hand - until then, every triage call costs real HF
#   Inference Endpoint money with nothing capping it.
#
# STANDARD_MONTHLY_PRICE_USD - what admin.html/dashboard.html show as a non-beta customer's price.
# BETA_MONTHLY_PRICE_USD - locked in for a customer marked beta (admin.html's Customers panel),
#   for BETA_DURATION_MONTHS from when they're granted it, regardless of what
#   STANDARD_MONTHLY_PRICE_USD is at the time (see effectivePrice() in api/_lib/billing.js).
# BETA_DURATION_MONTHS - how many months that lock lasts, counted from each customer's OWN
#   registration date - computed once, at grant time, and stored on that customer's own row
#   (`beta_locked_until`), so changing this env var later never retroactively shortens or extends
#   a duration a customer already locked in - only customers granted beta after the change see the
#   new value.
# MONTHLY_TRIAGE_LIMIT - shown as "X / this" in both the customer and admin usage views.
# MAX_BETA_USERS - once this many customers are marked beta, requesting beta status for a new one
#   is silently downgraded to the standard rate rather than rejected (api/admin-customers.js).
STANDARD_MONTHLY_PRICE_USD=29
BETA_MONTHLY_PRICE_USD=29
BETA_DURATION_MONTHS=12
MONTHLY_TRIAGE_LIMIT=100
MAX_BETA_USERS=10
